# Generated by XcodeGen from project.yml — never commit it.
# A checked-in .xcodeproj produces unreviewable merge conflicts on every PR and hides
# build settings from review, which is exactly where a size or signing regression would
# slip through unnoticed.
*.xcodeproj
*.xcworkspace

.build/
build/
dist/
DerivedData/
.swiftpm/

# Package.resolved IS committed (pinning is a supply-chain control), so it is not listed.

.DS_Store
*.dSYM
*.dSYM.zip

# Local signing material — never commit certificates or keys.
*.p12
*.cer
*.certSigningRequest
Tools/.signing/
