{
  "info": {
    "_postman_id": "aaaa1111-bbbb-2222-cccc-333333333333",
    "name": "Acme API",
    "description": "Everything Acme.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.acme.dev", "type": "default" },
    { "key": "apiVersion", "value": "v2" }
  ],
  "event": [
    { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [""] } }
  ],
  "item": [
    {
      "name": "Auth",
      "auth": {
        "type": "basic",
        "basic": [
          { "key": "username", "value": "ada", "type": "string" },
          { "key": "password", "value": "{{pw}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"ok\", () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Disabled", "value": "nope", "disabled": true }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"ada\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/{{apiVersion}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiVersion}}", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users?page=2&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "2" },
                { "key": "limit", "value": "50" },
                { "key": "draft", "value": "1", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/:userId",
              "path": ["users", ":userId"],
              "variable": [{ "key": "userId", "value": "42" }]
            }
          }
        },
        {
          "name": "Upload avatar",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "/tmp/pic.png" },
                { "key": "caption", "type": "text", "value": "hello" }
              ]
            },
            "url": "{{baseUrl}}/users/42/avatar"
          }
        }
      ]
    }
  ]
}
